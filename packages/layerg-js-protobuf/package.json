{
    "name": "@u2u-labs/layerg-js-protobuf",
    "version": "0.1.0",
    "description": "Websocket adapter adding protocol buffer support to the LayerG Javascript client.",
    "main": "dist/layerg-js-protobuf.cjs.js",
    "module": "dist/layerg-js-protobuf.esm.mjs",
    "types": "dist/layerg-js-protobuf/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": "./dist/layerg-js-protobuf.esm.mjs",
            "require": "./dist/layerg-js-protobuf.cjs.js"
        }
    },
    "scripts": {
        "build": "npx tsc && node build.mjs"
    },
    "devDependencies": {
        "ts-proto": "^1.80.1",
        "ts-proto-descriptors": "1.2.1"
    },
    "keywords": [
        "app server",
        "client library",
        "game server",
        "layerg",
        "realtime",
        "realtime chat"
    ],
    "repository": "https://github.com/u2u-labs/layerg-js",
    "homepage": "https://layerg.xyz",
    "bugs": "",
    "author": "",
    "contributors": [],
